{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(⚡deps)",
    ":timezone(Asia/Tokyo)"
  ],
  "labels": [
    "dependencies",
    "automated"
  ],
  "assignees": [
    "yanosea"
  ],
  "reviewers": [
    "yanosea"
  ],
  "schedule": [
    "* 0 * * *"
  ],
  "prConcurrentLimit": 10,
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "dependencyDashboard": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "All updates require manual approval",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates and pin digests",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "⚡deps",
      "semanticCommitScope": "workflow"
    },
    {
      "description": "Group Lume-related packages",
      "groupName": "Lume",
      "semanticCommitType": "⚡deps",
      "semanticCommitScope": "front",
      "matchPackageNames": [
        "/^lume$/",
        "/^https:\\/\\/deno\\.land\\/x\\/lume@/"
      ]
    },
    {
      "description": "Group Tailwind-related packages",
      "groupName": "Tailwind CSS",
      "semanticCommitType": "⚡deps",
      "semanticCommitScope": "front",
      "matchPackageNames": [
        "/^tailwindcss/",
        "/^@tailwindcss//"
      ]
    },
    {
      "description": "Frontend dependencies",
      "matchFileNames": [
        "front/**"
      ],
      "semanticCommitType": "⚡deps",
      "semanticCommitScope": "front"
    },
    {
      "description": "Backend Deno dependencies",
      "matchFileNames": [
        "back/deno.json"
      ],
      "semanticCommitType": "⚡deps",
      "semanticCommitScope": "back"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update npm dependencies in Deno imports",
      "managerFilePatterns": [
        "/(^|/)deno\\.json$/"
      ],
      "matchStrings": [
        "\"[^\"]+\": \"npm:(?<packageName>[^@]+)@\\^?(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ],
  "prBodyTemplate": "This PR contains the following updates:\n\n{{#if isMajor}}⚠️ **Major Update** - Please review carefully before merging.{{/if}}\n\n{{table}}\n\n---\n\n### Configuration\n\n📅 **Schedule**: {{schedule.description}}\n🚦 **Automerge**: {{#if automerge}}Enabled{{else}}Disabled{{/if}}\n♻ **Rebasing**: {{#if rebaseWhen}}{{rebaseWhen}}{{else}}Whenever PR becomes conflicted{{/if}}\n\n---\n\n_This PR was generated by [Renovate Bot](https://github.com/renovatebot/renovate)._"
}
